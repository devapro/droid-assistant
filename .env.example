# Copy to .env. Never commit the result.
#
# Credentials are read from the environment at the point of use and never enter
# the configuration file, a log line, or an API response (FR-CFG-4, NFR-SEC-5).

# Translation, the summary / action-item plugins, and — if you set
# `asr.backend = "openai"` — cloud speech recognition. Leave unset to run
# without them, or point llm.base_url at a local endpoint instead.
OPENAI_API_KEY=

# Cloud ASR (FR-ASR-3), if you prefer Deepgram to OpenAI. Either is required on
# Tier D hardware, and either is the answer for Live mode where local latency
# does not reach the target.
DEEPGRAM_API_KEY=

# Lifts Hugging Face's anonymous rate limit, which is usually what makes a
# first-run model download slow. Also required for the opt-in pyannote
# diarization backend, which additionally needs two gated licences accepted by
# hand on the Hub.
HF_TOKEN=

# --- speech models ---------------------------------------------------------
# The default model, used for any recording not pinned to a single language.
# DROID_ASR__BACKEND=faster_whisper
# DROID_ASR__MODEL=large-v3-turbo

# Extra models to keep on disk so they can be selected from Settings → Speech
# models without waiting for a download. Comma-separated `backend:model`.
#
# The models this configuration *routes to* are downloaded automatically — the
# default above, plus anything `asr.by_language` points at — so this list is
# only for models you want available to switch to. Keeping it derived rather
# than duplicated is deliberate: a hand-maintained download list drifts out of
# step with the routing, and the failure surfaces at the moment of recording.
# DROID_ASR__PRELOAD=faster_whisper:small,gigaam:v3-rnnt

# Fetch anything in that set that is missing on start, in the background. Off
# by default: on a fresh volume it is a multi-gigabyte download, and it should
# be a decision rather than a surprise. The server answers throughout either
# way, and reports progress at GET /api/models.
# DROID_ASR__DOWNLOAD_MISSING=true

# --- overrides -------------------------------------------------------------
# Any configuration field can be set here; `__` separates the sections.
# Per-language routing is nested too deeply to be pleasant here — set it from
# Settings → Speech models, or in config.toml:
#
#   [asr.by_language.ru]
#   backend = "gigaam"
#
# DROID_DATA_DIR=/mnt/ssd/droid
# DROID_PRIVACY__LOCAL_ONLY=true
# DROID_LOG_LEVEL=info
